{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desk Clock",
  "version": "0.1.0",
  "identifier": "private.deskclock.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Desk Clock",
        "width": 640,
        "height": 220,
        "minWidth": 240,
        "minHeight": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
